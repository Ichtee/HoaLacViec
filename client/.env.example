# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Maps JavaScript API Key (Optional: only needed if using Google Maps JS SDK)
VITE_GOOGLE_MAPS_API_KEY=

# App Metadata
VITE_APP_NAME=Hoa Lạc Việc
VITE_APP_VERSION=1.0.0
VITE_DATA_MODE=api
