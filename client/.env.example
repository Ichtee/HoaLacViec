# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── VIETMAP TILE KEY ───────────────────────────────────────────────
# Tile-only key for rendering map tiles in the browser (client-side safe)
# Security: Restrict by REFERRING DOMAIN in Vietmap Console → https://maps.vietmap.vn/console-v2/
# Quota:    Set per-key tile quota; browser SDK caches tiles aggressively
# Separate: Use DIFFERENT keys for dev and production
# Note:     This key is visible in browser JS; domain restriction is your defense
VITE_VIETMAP_TILE_API_KEY=

# App Metadata
VITE_APP_NAME=Hoa Lạc Việc
VITE_APP_VERSION=1.0.0
VITE_DATA_MODE=api
