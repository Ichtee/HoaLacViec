{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API for Hoa Lac Viec",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed/seed.js",
    "migrate:job-capacity": "node src/scripts/migrateJobCapacity.js",
    "migrate:application-index": "node src/scripts/migrateApplicationIndex.js",
    "reconcile:legacy-fields": "node src/scripts/reconcileLegacyFields.js",
    "migrate:verification-images": "node src/scripts/migrateVerificationImages.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.1",
    "morgan": "^1.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
