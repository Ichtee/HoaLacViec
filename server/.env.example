# Server Port (Default: 5000)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/hoalacviec
# Or MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hoalacviec

# JWT Secret Key (MANDATORY: server will fail fast if missing)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# CORS Whitelist (comma-separated origins allowed to call the API)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth (Backend token verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Vietmap Services API Key (Backend only - never expose to client)
# Used for Autocomplete v4, Place v4, Reverse v4, Route v4
VIETMAP_SERVICE_API_KEY=your_vietmap_services_api_key
# Flag to enable/disable Vietmap integration (fails fast in production if true and key missing)
ENABLE_VIETMAP=false
