# Server Port (Default: 5000)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/hoalacviec
# Or MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/hoalacviec

# JWT Secret Key (MANDATORY: server will fail fast if missing)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
# Thời hạn access token (mặc định 15m); refresh token sống 30 ngày
#ACCESS_TOKEN_TTL=15m

# CORS Whitelist (comma-separated origins allowed to call the API)
# Danh sách origin được phép (phân tách bằng dấu phẩy). Production chỉ cho phép đúng origin liệt kê + FRONTEND_URL.
# Web Push (tùy chọn): tạo khóa bằng `npx web-push generate-vapid-keys`
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Password reset email (Resend). Configure a verified sender domain in production.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

# Google OAuth (Backend token verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Temporary onboarding bypass. Keep false in normal/production operation.
# When enabled, pending accounts receive the selected role without changing stored verification data.
DISABLE_ACCOUNT_VERIFICATION=false
ACCOUNT_VERIFICATION_BYPASS_ROLE=student

# ─── VIETMAP CONFIGURATION ──────────────────────────────────────────
# Services API Key (Backend only — NEVER expose to client/frontend)
# Used for: Autocomplete v4, Search v4, Place v4, Reverse v4, Route v4, Matrix v4
# Security: Restrict by SERVER IP in Vietmap Console → https://maps.vietmap.vn/console-v2/
# Quota:    Set per-key daily quota; enable Matrix and disable APIs not in use (e.g. TSP, VRP)
# Separate: Use DIFFERENT keys for dev and production
VIETMAP_SERVICE_API_KEY=

# Base URL for Vietmap API (default: https://maps.vietmap.vn)
VIETMAP_API_BASE_URL=https://maps.vietmap.vn

# Flag to enable/disable Vietmap integration (server fails fast in production if true + key missing)
ENABLE_VIETMAP=false

# Lưu ảnh xác minh trên Cloudinary (tùy chọn). Khi thiếu, ảnh vẫn lưu dạng base64 trong MongoDB.
#CLOUDINARY_CLOUD_NAME=
#CLOUDINARY_API_KEY=
#CLOUDINARY_API_SECRET=
